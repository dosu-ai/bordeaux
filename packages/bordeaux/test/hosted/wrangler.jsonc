// The hosted tests' Worker (spec 09): every team on one Worker, found by host in the registry.
{
  "name": "bordeaux-hosted-test",
  "main": "worker.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      { "name": "BOARD", "class_name": "BoardDO" },
      { "name": "DIRECTORY", "class_name": "DirectoryDO" },
      { "name": "TAIL", "class_name": "TailDO" },
      { "name": "REGISTRY", "class_name": "RegistryDO" }
    ]
  },
  "assets": { "directory": "../../node_modules/@vercel/board/dist/inspect", "binding": "ASSETS", "run_worker_first": true },
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "bordeaux-files" }],
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["BoardDO", "DirectoryDO"] },
    { "tag": "v2", "new_sqlite_classes": ["TailDO"] },
    { "tag": "v3", "new_sqlite_classes": ["RegistryDO"] }
  ],
  // Each team's requests and wakes, and registry lookups per client IP (spec 09, "Limits"):
  // lower than production's, so a test reaches them.
  "ratelimits": [
    { "name": "REQUEST_LIMITER", "namespace_id": "1001", "simple": { "limit": 100, "period": 60 } },
    { "name": "WAKE_LIMITER", "namespace_id": "1002", "simple": { "limit": 60, "period": 60 } },
    { "name": "LOOKUP_LIMITER", "namespace_id": "1003", "simple": { "limit": 20, "period": 60 } }
  ],
  // The daily cron's work, one message per team (spec 09, "Crons fan out").
  "queues": { "producers": [{ "binding": "TEAMS_QUEUE", "queue": "bordeaux-teams" }], "consumers": [{ "queue": "bordeaux-teams" }] },
  "alias": { "@vercel/connect/chat": "../../src/sync/connect-chat.ts" },
  "vars": {
    "BORDEAUX_HOSTED_URL": "https://board.test",
    "GITHUB_CLIENT_ID": "Iv1.test",
    // A test value only: what the App's webhook secret would be.
    "GITHUB_WEBHOOK_SECRET": "hub-test-secret",
    "BORDEAUX_OPERATOR_ORG": "dosu-ai",
    // Test values only, made for this file: the sync App's ID, its webhook secret, and a key no
    // real App has (spec 09, "Sync, later").
    "GITHUB_SYNC_APP_ID": "77",
    "GITHUB_SYNC_WEBHOOK_SECRET": "sync-test-secret",
    "GITHUB_SYNC_PRIVATE_KEY": "-----BEGIN RSA PRIVATE KEY-----\nMIIEpQIBAAKCAQEA5aoZv0Izglb+8/RUuCnw5QF4eJYrfvh7mghQSM7nOEzv/7TV\n5qhYF+nLkiDw0PJKZcH+d7YYVlfbhUxIrc/zo1X6Xm1imnGM9MnWflfEpOVQz0II\n7NRb5VlACRjP/qQ2gz3mQmt1zMldDi+EIOfEGhiZgy+b+AdIOKzg1MpVJKMQ1ptt\n1G+mxPRe3xDJx6CPFtAS0hx+zBNqrTMdG/V4Y/w6Lm/hKqCknTXK8OCZHKrM+obu\nJlfE4YWg8sGpnR6NjmnpWxJ0VHlea1BttXaPNWlQP5oJUzf055bSme0JEhRE7kjM\ng0TuwF7bnBQUMRlDOblm5FJUnyhWFVaR8jCkpwIDAQABAoIBAAhzMiuamKpJcf36\naBwk1J2/Q/Ys/yT7OzayoZvcLYzYUh8bHOnsq2/yYAwTWejqvvQCp6oN6B1UBDWG\nVf/ylOj62ZGJ2aB5YDYo5mWTWfokVTr2YOH5Q2V0beoDMvvrpfU9XMvmPtkt6THf\nIotAiXxrvm2hpvJuiii4Peu/gy6+Q1VWUS1ZLpdpGpR+gc1N2CavXqQkcV82+6B3\nIscaqurJTnTmUzvWmCl1DtC81NetSJn0WmMK/Gzj6qyuWs1ZtQOMJnTUJUdluB9a\nNw6amiOWAwDeWGAJfUX++Sa4U1N99teKwddUyUkg+Xd0Wu0DxwLe+Moci7w2F8yL\n2oTnU6kCgYEA+xjHcKn23Fk3tNeKZC6T4R+8sS8rUD6ISUYa/L0fEty/rZYgTpte\nA85UjEc3My2TSMwpSR3gpreOK5ONUwHs1gTXPvbbySJxF1B+Q67nUC/MLgASIC6c\nXc8BI0ttnqJ/Cr5qAiy66Nt4WaF6TIB4GfQeNCO37kGnxjtMr7xuR4UCgYEA6iYu\nqXc1OqcaDAjGSxs7sZguvOqcgwXPBMQH9pNfl82teGqbLgwV/ghmNpm+ZzrWJfhc\nm38i1POtw4nlVCpUZR/btVgXkL9jCo0oY6nV812BIk5u49bsOrWMwEfN1pgnTvzQ\n4yQ5mp0HHR6rycJFCRRv9qcaPeFtBqk5KqwbVTsCgYEAoXNGUafHZdkr22i3wEC+\nrwL0Fc1pgTgj81FTauzDfSJZUOj1rvVxVuslK+likdKdIDK93RiL6Uae8F/4f8X+\nHYKRUBf0K/isVLxZ43UjoEiLdYxwGyc9PYgriCEow9Zh72uNyAYwzCbJ1H/iniwA\njVeM0COjUVv/35MjdN+o3O0CgYEArxADHTMCeirLf6njz+25kMtuTlK+1/s0z6Rd\nK879zrq5cumJwkDJBJh1C2ehgv7rc5IgcyX3/e1+wk7MRkQruzu5gfkuDUv6mb32\nL6WgUAdd8C9iGzjqf+6TIIPO8x3pbdX5u4mvA9lZozz2Ra/Y+7PrDifbp95uLGfD\nVRM+kFcCgYEA08Bqot+F2Ue1yt9R2Xm8ZTpcPe4vbR7Yqabby2sNRpq5PGNzK/vz\nzd3G0/TEzv5JiK2yGgLfRebALKDDKPgh5H9C434nzVaZWWfVUa1CqdeJONYSubCF\nrur3e+7uUhpb/4Xzuo9YbSUMBKlnfv9M/lP8BZiHvmir1EkhBt+smI4=\n-----END RSA PRIVATE KEY-----\n",
