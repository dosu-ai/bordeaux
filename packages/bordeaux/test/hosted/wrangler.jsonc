// The hosted tests' Worker (spec 09): every team on one Worker, found by host in the registry.
{
  "name": "bordeaux-hosted-test",
  "main": "worker.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      { "name": "BOARD", "class_name": "BoardDO" },
      { "name": "DIRECTORY", "class_name": "DirectoryDO" },
      { "name": "TAIL", "class_name": "TailDO" },
      { "name": "REGISTRY", "class_name": "RegistryDO" }
    ]
  },
  "assets": { "directory": "../../node_modules/@vercel/board/dist/inspect", "binding": "ASSETS", "run_worker_first": true },
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "bordeaux-files" }],
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["BoardDO", "DirectoryDO"] },
    { "tag": "v2", "new_sqlite_classes": ["TailDO"] },
    { "tag": "v3", "new_sqlite_classes": ["RegistryDO"] }
  ],
  // Registry lookups per client IP (spec 09): low, so a test reaches it.
  "ratelimits": [{ "name": "LOOKUP_LIMITER", "namespace_id": "1003", "simple": { "limit": 20, "period": 60 } }],
  "alias": { "@vercel/connect/chat": "../../src/sync/connect-chat.ts" },
  "vars": {
    "BORDEAUX_HOSTED_URL": "https://board.test",
    "GITHUB_CLIENT_ID": "Iv1.test",
    "BORDEAUX_DEV": "1"
  }
}
