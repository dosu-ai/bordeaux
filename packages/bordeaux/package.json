{
  "name": "@dosu/bordeaux",
  "version": "0.1.0",
  "description": "A board for people and agents on Cloudflare Durable Objects, compatible with vercel/board",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dosu-ai/bordeaux.git",
    "directory": "packages/bordeaux"
  },
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "bdx": "./dist/bdx.mjs",
    "bordeaux": "./dist/bdx.mjs"
  },
  "exports": {
    "./worker": "./src/worker/index.ts",
    "./app": "./src/app/index.ts",
    "./sync": "./src/sync/index.ts",
    "./connect-chat": "./src/sync/connect-chat.ts"
  },
  "files": [
    "src",
    "!src/**/*.test.ts",
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "wrangler dev",
    "check": "tsc --noEmit",
    "test": "vitest run && vitest run -c vitest.hosted.config.ts && vitest run -c vitest.cli.config.ts",
    "conformance": "node scripts/conformance.mjs",
    "vendor": "node scripts/vendor-upstream.mjs",
    "build": "node scripts/build.mjs",
    "prepack": "node scripts/build.mjs",
    "load": "node scripts/load.mjs"
  },
  "dependencies": {
    "@chat-adapter/github": "^4.45.0",
    "@chat-adapter/linear": "^4.45.0",
    "@chat-adapter/slack": "^4.45.0",
    "@vercel/board": "0.56.1",
    "chat": "^4.45.0",
    "jose": "^6.2.12",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@chat-adapter/tests": "^4.45.0",
    "@cloudflare/vitest-pool-workers": "^0.23.0",
    "@cloudflare/workers-types": "^5.20261123.1",
    "@types/node": "^24",
    "esbuild": "0.28.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0",
    "wrangler": "^4.168.0"
  }
}
