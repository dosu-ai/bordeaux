    "LINEAR_SYNC_CLIENT_ID": "linear-test-client",
    "LINEAR_SYNC_CLIENT_SECRET": "linear-test-secret",
    "LINEAR_SYNC_WEBHOOK_SECRET": "linear-hook-secret",
    "BORDEAUX_SYNC_KEY": "AAECAwQFBgcICQoLDA0ODxAREhMUFRYXGBkaGxwdHh8=",
    "BORDEAUX_DEV": "1"
  }
}
